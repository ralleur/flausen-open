+pragma ComponentBehavior: Bound
+import QtQuick
+import Quickshell
+import Quickshell.Wayland
+
+// Local compositor passes: never change the shared KWin blur configuration.
+Scope {
+    id: root
+    required property var screen
+    required property Item target
+    required property bool active
+    readonly property point origin: Qt.point(target.x + target.parent.leftMargin, target.y + target.parent.topMargin)
+    Variants {
+        model: root.active ? [0, 1, 2, 3, 4, 5, 6, 7] : []
+        PanelWindow {
+            id: pass
+            required property var modelData
+            screen: root.screen
+            visible: root.active
+            anchors { top: true; left: true }
+            margins { top: Math.round(root.origin.y); left: Math.round(root.origin.x) }
+            implicitWidth: Math.max(1, Math.min(Math.ceil(root.target.width), root.screen.width - Math.round(root.origin.x)))
+            implicitHeight: Math.ceil(root.target.height)
+            exclusionMode: ExclusionMode.Ignore
+            WlrLayershell.layer: WlrLayer.Top
+            WlrLayershell.namespace: "ralleur-calendar-glass"
+            WlrLayershell.keyboardFocus: WlrKeyboardFocus.None
+            mask: Region {}
+            color: "transparent"
+            surfaceFormat.opaque: false
+            Rectangle { anchors.fill: parent; radius: 28; color: "#01000000" }
+            BackgroundEffect.blurRegion: Region { item: pass.contentItem; radius: 28 }
+        }
+    }
+}
