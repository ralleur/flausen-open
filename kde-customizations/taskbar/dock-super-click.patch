+    // Arm Krohnkite before starting the app, so even fast windows are matched.
+    function activateTiledEntry(entry: var): void {
+        if (!entry?.entry)
+            return;
+        const aliases = [...new Set([entry.entry.id, entry.appClass, entry.id].filter(value => !!value))];
+        const request = tiledLaunchRequest.createObject(root, {
+            dockEntry: entry,
+            command: ["qdbus6", "org.kde.KWin", "/RalleurTilingLaunch",
+                "org.ralleur.TilingLaunch.arm", JSON.stringify(aliases)]
+        });
+        request.running = true;
+    }
+
+    Component {
+        id: tiledLaunchRequest
+        Process {
+            required property var dockEntry
+            stdout: StdioCollector {}
+            onExited: (exitCode, exitStatus) => {
+                if (exitCode === 0 && stdout.text.trim() === "true") {
+                    root.activateNewEntry(dockEntry);
+                } else {
+                    console.warn("Dock: Krohnkite tiling launch request failed");
+                    Quickshell.execDetached(["notify-send", "Tiling-Start fehlgeschlagen",
+                        "Krohnkite ist nicht erreichbar. Bitte erneut versuchen."]);
+                }
+                destroy();
+            }
+        }
+    }
