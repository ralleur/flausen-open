+#!/usr/bin/env python3
+"""Read or change the dock's Battle.net Framegen switch."""
+import argparse
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+from lab.core import LabError
+from lab.framegen import status, set_enabled
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('action', choices=['status', 'on', 'off'], default='status', nargs='?')
+args = parser.parse_args()
+try:
+    print(json.dumps(status() if args.action == 'status' else set_enabled(args.action == 'on')))
+except (LabError, OSError) as error:
+    print(json.dumps({'error': str(error)}))
+    sys.exit(1)
