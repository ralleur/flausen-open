+"""Persistent, launcher-scoped NVIDIA Smooth Motion preference."""
+import os
+from pathlib import Path
+
+from .core import STATE, LabError, locked, save_json
+
+OPTION = 'NVPRESENT_ENABLE_SMOOTH_MOTION'
+SETTING = STATE / 'battlenet-framegen.json'
+EXECUTABLES = {'battle.net.exe', 'battle.net launcher.exe', 'wow.exe',
+               'wowclassic.exe', 'wowclassict.exe', 'wowb.exe', 'wowt.exe'}
+
+
+def running(proc=Path('/proc')):
+    for process in proc.iterdir():
+        if not process.name.isdecimal():
+            continue
+        try:
+            if process.stat().st_uid != os.getuid():
+                continue
+            args = (process / 'cmdline').read_bytes().split(b'\0')
+            # Wine may put the Windows executable in argv[0] or after its loader.
+            if any(arg.decode(errors='replace').replace('\\', '/').rsplit('/', 1)[-1].lower()
+                   in EXECUTABLES for arg in args):
+                return True
+        except (FileNotFoundError, ProcessLookupError):
+            continue
+        except PermissionError:
+            # A same-user process we cannot inspect must not permit a live change.
+            return True
+    return False
+
+
+def status():
+    return {'enabled': SETTING.is_file(), 'running': running()}
+
+
+def set_enabled(enabled):
+    with locked():
+        if running():
+            raise LabError('Battle.net oder WoW zuerst vollständig schließen.')
+        if enabled:
+            save_json(SETTING, {'enabled': True})
+        else:
+            SETTING.unlink(missing_ok=True)
+    return status()
+
+
+def launch_environment():
+    env = os.environ.copy()
+    if SETTING.is_file():
+        env[OPTION] = '1'
+    else:
+        env.pop(OPTION, None)
+    return env
