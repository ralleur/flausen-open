+from pathlib import Path
+import os
+import tempfile
+import unittest
+from unittest.mock import patch
+
+from lab import framegen, gaming
+
+
+class Framegen(unittest.TestCase):
+    def test_switch_persists_and_off_removes_option_even_if_inherited(self):
+        with tempfile.TemporaryDirectory() as directory, \
+                patch.object(framegen, 'SETTING', Path(directory) / 'framegen.json'), \
+                patch.object(framegen, 'running', return_value=False), \
+                patch.dict(os.environ, {framegen.OPTION: '1', 'FRAMEGEN_TEST_OTHER': 'kept'}):
+            self.assertFalse(framegen.status()['enabled'])
+            self.assertNotIn(framegen.OPTION, framegen.launch_environment())
+            self.assertTrue(framegen.set_enabled(True)['enabled'])
+            self.assertEqual(framegen.launch_environment()[framegen.OPTION], '1')
+            self.assertFalse(framegen.set_enabled(False)['enabled'])
+            self.assertFalse(framegen.SETTING.exists())
+            self.assertNotIn(framegen.OPTION, framegen.launch_environment())
+            self.assertEqual(framegen.launch_environment()['FRAMEGEN_TEST_OTHER'], 'kept')
+
+    def test_running_launcher_or_game_locks_both_directions(self):
+        with tempfile.TemporaryDirectory() as directory, \
+                patch.object(framegen, 'SETTING', Path(directory) / 'framegen.json'):
+            for enabled in (False, True):
+                if enabled:
+                    framegen.SETTING.touch()
+                with patch.object(framegen, 'running', return_value=True):
+                    with self.assertRaises(framegen.LabError):
+                        framegen.set_enabled(not enabled)
+                self.assertEqual(framegen.SETTING.exists(), enabled)
+
+    def test_detects_windows_paths_and_ignores_agent_and_other_processes(self):
+        with tempfile.TemporaryDirectory() as directory:
+            proc = Path(directory)
+            process = proc / '123'
+            process.mkdir()
+            cmdline = process / 'cmdline'
+            for name in ('Battle.net.exe', 'Battle.net Launcher.exe', 'Wow.exe', 'WowClassic.exe'):
+                cmdline.write_bytes(b'wine64\0C:\\Games\\' + name.encode() + b'\0')
+                self.assertTrue(framegen.running(proc), name)
+            for args in (b'Agent.exe\0', b'python\0battlenet-framegen\0status\0', b'konsole\0'):
+                cmdline.write_bytes(args)
+                self.assertFalse(framegen.running(proc), args)
+
+    def test_launcher_receives_preference_but_other_apps_do_not(self):
+        with patch.object(gaming, 'battlenet_installation', return_value={'id': 7}), \
+                patch.object(gaming.shutil, 'which', return_value='/usr/bin/lutris'), \
+                patch('lab.framegen.launch_environment', return_value={framegen.OPTION: '1'}) as env, \
+                patch('subprocess.Popen') as start:
+            start.return_value.wait.return_value = 0
+            gaming.launch('battlenet')
+            self.assertEqual(start.call_args.kwargs['env'][framegen.OPTION], '1')
+            env.assert_called_once()
+            gaming.launch('steam')
+            self.assertNotIn('env', start.call_args.kwargs)
