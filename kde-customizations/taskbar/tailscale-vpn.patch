+        stdout: StdioCollector {
+            onStreamFinished: {
+                try { root.tailscaleStatus = JSON.parse(text); }
+                catch (e) { root.tailscaleStatus = {installed: root.tailscaleStatus.installed, connected: false, detail: "Status nicht verfügbar"}; }
+            }
+        }
+    }
+    Process {
+        id: tailscaleAction
+        property var result: ({success: false, error: "Tailscale konnte nicht ausgeführt werden"})
+        onStarted: result = {success: false, error: "Tailscale konnte nicht ausgeführt werden"}
+        stdout: StdioCollector { onStreamFinished: { try { tailscaleAction.result = JSON.parse(text); } catch (e) {} } }
+        onExited: {
