--- /dev/null
+++ services/UpdateHub.qml
@@ -0,0 +1,141 @@
+pragma Singleton
+pragma ComponentBehavior: Bound
+import QtQuick
+import QtCore
+import Quickshell
+import Quickshell.Io
+import Caelestia
+import qs.services
+
+Singleton {
+    id: root
+    property var status: ({})
+    property string error: ""
+    property double lastCheck: 0
+    property bool online: true
+    readonly property bool checking: probe.running && online
+    readonly property var sources: [
+        {key: "steam", name: "Steam", hint: "Client-Updates und Beta-Kanal in Steam → Einstellungen → Oberfläche", desktop: "steam", url: "steam://open/settings"},
+        {key: "steamGames", name: "Steam · Spiele", hint: "Downloads, Zeitplan und Limits; je Spiel: Eigenschaften → Updates", desktop: "steam", url: "steam://open/downloads"},
+        {key: "battlenet", name: "Battle.net", hint: "Client-Updates werden von Battle.net verwaltet. Einstellungen im Launcher öffnen.", desktop: "lab-battlenet"},
+        {key: "battlenetGames", name: "Battle.net · Spiele", hint: "Im Launcher: Einstellungen → Downloads → automatische Updates", desktop: "lab-battlenet"},
+        {key: "wowup", name: "WowUp", hint: "App-Updates und Addons: Optionen → WoW-Clients; einzelne Addons separat einstellbar", desktop: "lab-wowup"},
+        {key: "artcraft", name: "ArtCraft · Suite", hint: "Suite-Updates, Prüfintervall und automatische Updates im ArtCraft Launcher einstellen", desktop: "ai.storyteller.artcraft-launcher"}
+    ]
+    readonly property int pendingCount: sources.reduce((sum, source) => sum + (enabled(source.key) ? (status[source.key]?.pending?.length ?? 0) + (status[source.key]?.addonPending ?? 0) : 0), 0)
+    readonly property bool hasErrors: sources.some(source => enabled(source.key) && !!status[source.key]?.error)
+    readonly property string overview: checking ? "Online-Prüfung läuft …" : pendingCount > 0 ? pendingCount + " Updates verfügbar" : hasErrors ? "Einige Quellen sind nicht erreichbar" : "Keine bekannten App-Updates"
+    Settings {
+        id: prefs
+        category: "RalleurUpdateHub"
+        property string hiddenSources: "[]"
+    }
+    function enabled(key: string): bool {
+        try { return !JSON.parse(prefs.hiddenSources).includes(key); } catch (e) { return true; }
+    }
+    function setEnabled(key: string, value: bool): void {
+        let hidden;
+        try { hidden = JSON.parse(prefs.hiddenSources); } catch (e) { hidden = []; }
+        hidden = hidden.filter(k => k !== key);
+        if (!value) hidden.push(key);
+        prefs.hiddenSources = JSON.stringify(hidden);
+        prefs.setValue("hiddenSources", prefs.hiddenSources);
+        prefs.sync();
+    }
+    function stamp(seconds: double): string {
+        return seconds > 0 ? new Date(seconds * 1000).toLocaleString(Qt.locale("de_DE"), "dd.MM. HH:mm") : "noch nie";
+    }
+    function itemState(item: var): string {
+        if (item.downloading) {
+            const percent = item.bytesTotal > 0 ? Math.min(100, Math.floor(item.bytesDownloaded * 100 / item.bytesTotal)) + " %" : "";
+            return "Download läuft " + percent;
+        }
+        if (item.state === "update") return "Update verfügbar";
+        if (item.state === "current") return "Aktuell";
+        if (item.state === "ahead") return "Neuer als der veröffentlichte Stand";
+        if (item.state === "local") return "Kein Update vorgemerkt";
+        return "Versionsvergleich nicht möglich";
+    }
+    function statusIcon(key: string): string {
+        const value = status[key];
+        if (root.checking) return "sync";
+        if ((value?.pending?.length ?? 0) + (value?.addonPending ?? 0) > 0 || value?.downloading > 0) return "arrow_upward";
+        if (root.error || !value || value.error || value.stale || !value.items?.length || value.items.some(item => item.state === "unknown")) return "question_mark";
+        if (key === "wowup" && (!value.addonCheckedAt || Date.now() / 1000 - value.addonCheckedAt > 86400)) return "question_mark";
+        return "check";
+    }
+    function summary(key: string): string {
+        const value = status[key];
+        if (!value) return "Noch nicht geprüft";
+        if (value.error && !value.items?.length) return "Prüfung fehlgeschlagen · " + value.error;
+        if (value.installed === 0) return key === "steamGames" ? "Keine Steam-Spiele installiert" : "Nicht installiert";
+        let label;
+        const pending = value.pending?.length ?? 0;
+        if (key === "steamGames") {
+            label = value.downloading > 0 ? value.downloading + " Downloads laufen" : pending > 0 ? pending + " Updates vorgemerkt" : value.installed + " Titel · keine Updates vorgemerkt";
+        } else if (pending > 0) label = pending + " Updates verfügbar";
+        else if (value.items.some(item => item.state === "unknown")) label = "Versionsstand teilweise unbekannt";
+        else if (value.items.some(item => item.state === "ahead")) label = "Installierter Stand neuer als Release";
+        else label = value.items.length === 1 ? (key === "steam" ? "Build " : "Version ") + value.items[0].installedVersion + " · aktuell" : value.items.length + (key === "battlenetGames" ? " Spiele aktuell" : " Apps aktuell");
+        if (key === "wowup") label += " · " + value.addons.length + " Addons, " + value.addonPending + " bekannte Updates";
+        if (value.stale) label = (value.error ? "Offline · letzter Stand: " : "Veralteter Prüfstand: ") + label;
+        return label;
+    }
+    function details(key: string): string {
+        const value = status[key];
+        if (!value) return "Die erste Prüfung läuft beim Öffnen der Shell.";
+        const lines = (value.items ?? []).map(item => {
+            let line = item.name + ": " + (item.installedVersion || "unbekannt");
+            if (item.latestVersion && item.latestVersion !== item.installedVersion) line += " → " + item.latestVersion;
+            line += " · " + root.itemState(item);
+            if (item.policy) line += " · " + item.policy;
+            if (item.detail) line += "\n" + item.detail;
+            return line;
+        });
+        if (value.evidence) lines.push(value.evidence + " · geprüft " + root.stamp(value.checkedAt));
+        if (value.error) lines.push("Online-Prüfung fehlgeschlagen: " + value.error);
+        if (key === "wowup" && value.addons) {
+            lines.push("Addon-Daten aus WowUp vom " + root.stamp(value.addonCheckedAt) + ": " + value.addonPending + " bekannte Updates · " + value.addonAutoUpdate + " mit Auto-Update");
+            value.addons.filter(item => item.state === "update").slice(0, 8).forEach(item => lines.push(item.name + ": " + item.installedVersion + " → " + item.latestVersion));
+        }
+        if (key === "artcraft" && value.feedTimestamp) lines.push("ArtCraft-Feed vom " + new Date(value.feedTimestamp).toLocaleString(Qt.locale("de_DE"), "dd.MM. HH:mm"));
+        if (key === "artcraft" && value.autoUpdate !== undefined) lines.push("Automatische Suite-Updates: " + (value.autoUpdate === null ? "unbekannt" : value.autoUpdate ? "an" : "aus"));
+        return lines.join("\n");
+    }
+    function compact(key: string): string {
+        const value = status[key];
+        let text = root.summary(key);
+        if (value?.items?.length > 1 && key !== "steamGames") text += "\n" + value.items.map(item => item.name.replace("World of Warcraft · ", "WoW ") + " " + item.installedVersion + (item.state === "update" ? " → " + item.latestVersion : "")).join(" · ");
+        if (value?.checkedAt) text += "\n" + (key === "steamGames" ? "Lokal gelesen " : "Online geprüft ") + root.stamp(value.checkedAt);
+        if (key === "wowup" && value?.addonCheckedAt) text += "\nAddon-Stand " + root.stamp(value.addonCheckedAt);
+        return text;
+    }
+    function open(source: var): void {
+        if (source.url) Qt.openUrlExternally(source.url);
+        else Launch.exec(["gtk-launch", source.desktop]);
+    }
+    function refresh(checkOnline) {
+        if (probe.running) return;
+        root.online = checkOnline !== false;
+        probe.running = true;
+    }
+    Process {
+        id: probe
+        command: ["python3", Qt.resolvedUrl("update-hub-probe.py").toString().replace("file://", ""), ...(root.online ? [] : ["--local"])]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                try { root.status = JSON.parse(text); root.error = ""; root.lastCheck = Date.now(); }
+                catch (e) { root.error = "Update-Prüfung konnte nicht gelesen werden"; }
+            }
+        }
+        onExited: code => { if (code !== 0) root.error = "Update-Prüfung fehlgeschlagen (" + code + ")"; }
+    }
+    IpcHandler {
+        target: "updateHub"
+        function inspect(): string {
+            return JSON.stringify({status: root.status, error: root.error, checking: root.checking, lastCheck: root.lastCheck, enabled: root.sources.filter(s => root.enabled(s.key)).map(s => s.key)});
+        }
+    }
+    Timer { interval: 20000; repeat: true; running: true; onTriggered: root.refresh(false) }
+    Timer { interval: 1800000; repeat: true; running: true; triggeredOnStart: true; onTriggered: root.refresh() }
+}
--- /dev/null
