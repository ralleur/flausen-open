{
  "manifest_version": 3,
  "name": "flausen Spotify window controls",
  "version": "1.0.1",
  "description": "Integrierte Fenstersteuerung für die Spotify-Webapp unter KWin.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": {"service_worker": "window-bridge.js"},
  "content_scripts": [{
    "matches": ["https://open.spotify.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
