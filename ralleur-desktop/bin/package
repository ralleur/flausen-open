#!/usr/bin/env python3
"""Create a source/install archive; never bundle local runtime libraries or fonts."""
import hashlib
from pathlib import Path
import tarfile
ROOT=Path(__file__).resolve().parents[1]
version=(ROOT/'VERSION').read_text().strip()
out=ROOT.parent/'dist'; out.mkdir(exist_ok=True)
path=out/f'ralleur-desktop-{version}.tar.gz'
with tarfile.open(path,'w:gz') as archive:
    for file in sorted(ROOT.rglob('*')):
        relative=file.relative_to(ROOT)
        if any(part in ('build','__pycache__') for part in relative.parts) or file.suffix=='.pyc': continue
        if file.is_file(): archive.add(file,arcname='ralleur-desktop/'+str(relative),recursive=False)
    references=ROOT.parent/'ralleur-caelestia-codex-handoff/reference'
    for name in ('desktop-light.png','desktop-dark.png'):
        file=references/name
        if file.is_file(): archive.add(file,arcname='ralleur-caelestia-codex-handoff/reference/'+name,recursive=False)
checksum=hashlib.sha256(path.read_bytes()).hexdigest()
path.with_suffix(path.suffix+'.sha256').write_text(checksum+'  '+path.name+'\n')
print(path)
